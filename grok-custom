#!/bin/bash

set -euo pipefail
umask 077

readonly GROK_BINARY="/opt/grok-custom/grok"

if [[ -z "${HOME:-}" ]]; then
    echo "grok-custom: HOME is not set" >&2
    exit 1
fi

if [[ "${HOME}" != /* ]]; then
    echo "grok-custom: HOME must be an absolute path: ${HOME}" >&2
    exit 1
fi

if [[ ! -d "${HOME}" ]]; then
    echo "grok-custom: HOME is not a directory: ${HOME}" >&2
    exit 1
fi

if [[ ! -f "${GROK_BINARY}" ]]; then
    echo "grok-custom: Grok binary not found: ${GROK_BINARY}" >&2
    exit 1
fi

if [[ ! -x "${GROK_BINARY}" ]]; then
    echo "grok-custom: Grok binary is not executable: ${GROK_BINARY}" >&2
    exit 1
fi

export GROK_HOME="${HOME}/.grok"
export GROK_LEADER_SOCKET="${GROK_HOME}/leader.sock"

# Enable the explicitly feature-compiled experimental Claude Agent CLI runtime.
# The CLI still performs its official binary/version/subscription probes and
# remains independent from the Anthropic API-key provider path.
export GROK_CLAUDE_CLI_RUNTIME=1

# Export content-redacted production usage telemetry to the dedicated Alloy
# receiver. Pin the routing before Grok starts so ambient OTEL settings cannot
# mix this profile with development or leak unrelated collector credentials.
export GROK_EXTERNAL_OTEL=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
export OTEL_EXPORTER_OTLP_ENDPOINT=http://vm.services:24318
export OTEL_LOG_USER_PROMPTS=0
export OTEL_LOG_TOOL_DETAILS=0
unset OTEL_EXPORTER_OTLP_LOGS_ENDPOINT OTEL_EXPORTER_OTLP_METRICS_ENDPOINT
unset OTEL_EXPORTER_OTLP_HEADERS OTEL_EXPORTER_OTLP_LOGS_HEADERS
unset OTEL_EXPORTER_OTLP_METRICS_HEADERS

if ! /bin/mkdir -p "${GROK_HOME}"; then
    echo "grok-custom: failed to create GROK_HOME: ${GROK_HOME}" >&2
    exit 1
fi

if [[ ! -d "${GROK_HOME}" ]]; then
    echo "grok-custom: GROK_HOME is not a directory: ${GROK_HOME}" >&2
    exit 1
fi

if ! /bin/chmod 0700 "${GROK_HOME}"; then
    echo "grok-custom: failed to secure GROK_HOME: ${GROK_HOME}" >&2
    exit 1
fi

export GROK_CURSOR_SKILLS_ENABLED=0
export GROK_CURSOR_RULES_ENABLED=0
export GROK_CURSOR_AGENTS_ENABLED=0
export GROK_CURSOR_MCPS_ENABLED=0
export GROK_CURSOR_HOOKS_ENABLED=0
export GROK_CURSOR_SESSIONS_ENABLED=0

export GROK_CLAUDE_SKILLS_ENABLED=0
export GROK_CLAUDE_RULES_ENABLED=0
export GROK_CLAUDE_AGENTS_ENABLED=0
export GROK_CLAUDE_MCPS_ENABLED=0
export GROK_CLAUDE_HOOKS_ENABLED=0
export GROK_CLAUDE_SESSIONS_ENABLED=0

export GROK_CODEX_SKILLS_ENABLED=0
export GROK_CODEX_RULES_ENABLED=0
export GROK_CODEX_AGENTS_ENABLED=0
export GROK_CODEX_MCPS_ENABLED=0
export GROK_CODEX_HOOKS_ENABLED=0
export GROK_CODEX_SESSIONS_ENABLED=0

exec "${GROK_BINARY}" "$@"
